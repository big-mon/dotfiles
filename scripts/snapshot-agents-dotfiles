#!/bin/bash
set -euo pipefail

commit_message="${1:-}"
if [[ -z "$commit_message" ]]; then
	printf 'error: a commit message is required\n' >&2
	printf 'usage: scripts/snapshot-agents-dotfiles "Commit message"\n' >&2
	exit 64
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
	printf 'error: not inside a Git repository\n' >&2
	exit 2
}
cd "$repo_root"

if [[ -z "$(git status --porcelain)" ]]; then
	printf 'No agents dotfiles changes to snapshot.\n'
	exit 0
fi

check_path() {
	local path="$1"
	local lower
	lower="$(printf '%s' "$path" | tr '[:upper:]' '[:lower:]')"

	case "$lower" in
	.env | .env.* | */.env | */.env.* | *.pem | *.key | *.p12 | *.pfx | *credentials* | *secrets*)
		printf 'error: suspicious filename is not allowed in this public repository: %s\n' "$path" >&2
		return 1
		;;
	esac

	if [[ -f "$path" ]] && /usr/bin/grep -qE -- '-----BEGIN ([A-Z0-9 ]+ )?PRIVATE KEY-----' "$path"; then
		printf 'error: private key material detected in: %s\n' "$path" >&2
		return 1
	fi
}

while IFS= read -r -d '' path; do
	case "$path" in
	users/agents/dotfiles | users/agents/dotfiles/*) ;;
	*)
		printf 'error: refusing automatic snapshot because a change exists outside users/agents/dotfiles: %s\n' "$path" >&2
		exit 1
		;;
	esac
	check_path "$path"
done < <(
	{
		git diff --no-renames --name-only -z
		git diff --cached --no-renames --name-only -z
		git ls-files --others --exclude-standard -z
	} | sort -zu
)

# Validate the standard account's mise config before staging.
agents_config="$repo_root/users/agents"
mise -C "$agents_config" fmt --check
mise -C "$agents_config" tasks validate
if [[ -d tests ]]; then
	/usr/bin/python3 -B -m unittest discover -s tests -v
fi

git diff --check
git add -A -- users/agents/dotfiles
git diff --cached --check

printf '\nAgents dotfiles to snapshot:\n'
git diff --cached --stat
git diff --cached --name-status

git -c core.hooksPath=/dev/null commit -m "$commit_message" -- users/agents/dotfiles
git -c core.hooksPath=/dev/null push

printf '\nSnapshotted agents dotfiles successfully.\n'
